# NASER AI MEDIA ENGINE - ENVIRONMENT CONFIGURATION
# Add these values to your local .env or to GitHub Repository Secrets!

# --- AI PROVIDERS ---
# Primary: Groq API Key (https://console.groq.com)
GROQ_API_KEY=

# Secondary Fallback: Google AI Studio Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=

# Optional: OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional: Custom FreeLLM / Proxy Endpoint (e.g. http://localhost:3001)
FREELLM_ENDPOINT=

# --- PLATFORM COOKIES & CREDENTIALS ---
# 1. Single Combined Netscape Cookies File (Recommended):
# Copy and paste the entire contents of your exported cookies.txt into GitHub Secret 'COOKIES_TXT'
COOKIES_TXT=

# Or specify local file path:
COOKIES_TXT_PATH=cookies.txt

# Or Individual Overrides:
SUBSTACK_SID=
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# --- OPTIONAL FREE APIS ---
# Buttondown Newsletter REST API Key (https://buttondown.email/settings/programming)
BUTTONDOWN_API_KEY=

# Telegram Channel Broadcast (via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
